APP_ENV=local

# Execução local no host. Ajuste a porta para FORWARD_DB_PORT do InteliReg.
DATABASE_URL=postgresql+psycopg://intelireg:intelireg_local@localhost:5433/intelireg

# Execução do bulario-service via Docker Compose.
# O container usa a rede do Compose do InteliReg e acessa o serviço `db` na porta interna 5432.
BULARIO_DOCKER_DATABASE_URL=postgresql+psycopg://intelireg:intelireg_local@db:5432/intelireg
INTELIREG_DOCKER_NETWORK=intelireg-local_default

# Acervo físico neutro compartilhado entre produtor e Portal.
# Em execução no host, o bulario-service grava diretamente neste diretório.
BULARIO_STORAGE_ROOT=../intelireg-data/bulas

# Bind source usado quando o bulario-service roda via Docker Compose.
# Deve apontar para o mesmo acervo físico de BULARIO_STORAGE_ROOT.
BULAS_ARCHIVE_HOST_PATH=../intelireg-data/bulas

# Sobreposição temporal do incremental. Valor técnico inicial e configurável;
# deve ser calibrado com observação da fonte e não é requisito regulatório.
BULARIO_INCREMENTAL_OVERLAP_DAYS=7
